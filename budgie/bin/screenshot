#!/bin/bash
# budgie-screenshot -
#       This script provides a modern process for taking a screenshot.
#       As budgie ported itself to Wayland but with tons of problems,
#       One of them is that the built-in screenshot operation is too simple.
#       Also it will not first capture a STATIC* picture to choose, nor letting 
#       you edit the captured picture. <STATIC*>: Budgie just overlay a layer on
#       top of monitor, that you lost the specifc static frame when you pressed PrtSc.
#       This script simulates the way how traditional Wayland-WM users (like sway,
#       hyprland) taking a screenshot.

# This script is designed for Budgie > 10.10 (Wayland age).
# If you are using Budgie 10.9, nothing will happen as grim sliently exits.

# This script is part of 0xarch's DesktopExperience project that aims to 
# improve the experience of linux desktop users.

# REQUIRES EXECUTABLES:
# xdg-user-dir (part of xdg core package. You don't need to install twice.)
# mkdir, cp, rm, basename (coreutils)
# grim
# slurp
# swayimg
# magick
# awk
# swappy
# wl-copy
# notify-send

screenshot_dir="$(xdg-user-dir PICTURES)/Screenshots"
mkdir -p "$screenshot_dir"

timestamp=$(date +%Y-%m-%d_%H-%M-%S)
filename="$screenshot_dir/$timestamp.png"
temp_file="/tmp/screenshot_$$.png"

# Capture fullscreen first
grim "$temp_file"

# Show preview
swayimg -f "$temp_file" -c info.show=no &
swayimg_pid=$!

region=$(slurp -b 00000055 -c 00FF00FF -w 2)
slurp_exit=$?

kill $swayimg_pid 2>/dev/null
wait $swayimg_pid 2>/dev/null

if [ $slurp_exit -eq 0 ] && [ -n "$region" ]; then
    echo Slurp exited with 0.
        echo "$region" | awk -F'[, x]' '{
        # $1=X, $2=Y, $3=W, $4=H
        printf "%dx%d+%d+%d", $3, $4, $1, $2
    }' | while read crop_region; do
        magick "$temp_file" -crop "$crop_region" +repage "$filename"
    done
    # magick "$temp_file" -crop "$region" +repage "$filename"
else
    echo Slurp exited with non-zero.
    cp "$temp_file" "$filename"
fi

swappy -f "$filename" -o "$filename" 2>/dev/null

wl-copy < "$filename" 2>/dev/null

notify-send "Screenshot saved." "$(basename "$filename")" 2>/dev/null

rm -f "$temp_file"
