#!/bin/bash

# arg: <none> or 0 or 1
# 0 for dark
# 1 for light
# <none> for auto switch

DARK_MODE_SIG="'prefer-dark'"
LIGHT_MODE_SIG="'prefer-light'"

function is_dark_mode_now {
  if [ "$1" != "" ]; then
    return $1
  fi
  [ "$(gsettings get org.gnome.desktop.interface color-scheme)" == "$DARK_MODE_SIG" ]
  return $?
}

MODE=$DARK_MODE_SIG
QT_MODE="CosmicDark"
COSMIC_IS_DARK="true"

if is_dark_mode_now; then
  MODE=$LIGHT_MODE_SIG
  QT_MODE="CosmicLight"
  COSMIC_IS_DARK="false"
fi

if [ -e ~/.config/cosmic/com.system76.CosmicTheme.Mode/v1/is_dark ]; then
  echo $COSMIC_IS_DARK >~/.config/cosmic/com.system76.CosmicTheme.Mode/v1/is_dark
fi
gsettings set org.gnome.desktop.interface color-scheme "$MODE"
if which plasma-apply-colorscheme; then
  plasma-apply-colorscheme "$QT_MODE"
fi
