#!/bin/bash

## From https://github.com/end-4/dots-hyprland
getaudiooutput() {
  pactl list sources | grep 'Name' | grep 'monitor' | cut -d ' ' -f2
}

pkill wf-recorder

IS_RECORDER_ALIVE=$?

NOTIFY_SENDER=notify-send
if which noctalia; then
  NOTIFY_SENDER="noctalia msg notification-show"
fi

if [ "$IS_RECORDER_ALIVE" == "0" ]; then
  $NOTIFY_SENDER "Record saved" "at $(date)"
else
  SAVE_PATH="$(xdg-user-dir VIDEOS)/ScreenCaptures/$(date +%Y-%m-%d_%H-%M-%S).mp4"
  mkdir -p $(dirname "$SAVE_PATH")
  $NOTIFY_SENDER "Recording started" "at $(date)"
  wf-recorder --audio="$(getaudiooutput)" -f "$SAVE_PATH"
fi
